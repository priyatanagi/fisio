# ---------------------------------------------------------------------------
# Fisio Architect 2.0 — environment template
# Copy this file to `.env` (gitignored) and fill in what you actually use.
#
# HOW PROVIDERS RESOLVE (read this first):
#   Per-role provider settings (provider, model, base URL, API key) are chosen
#   in the in-app "Providers" view and are stored in your browser, then sent
#   with each request. The values below are SERVER-SIDE FALLBACKS / DEFAULTS
#   only — they kick in when a role leaves the matching field blank.
#   You do NOT have to set every variable. Set only what your setup needs.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY
#   Fallback key for the Gemini provider. Required only if a role uses Gemini
#   AND leaves its own API key blank in the Providers view. AI Studio injects
#   this automatically from the Secrets panel; for local `npm run dev` put your
#   key here. Get one at https://aistudio.google.com/apikey
#   Leave blank if you are testing with Ollama (no cloud key needed at all).
GEMINI_API_KEY=""

# OLLAMA_BASE_URL
#   Default base URL for the "Ollama (Local)" provider, used when a role's base
#   URL field is blank. Ollama must be running locally (`ollama serve`, default
#   port 11434). This is the zero-cost path for end-to-end testing.
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_MODEL
#   Default model id for the Ollama provider when a role's model field is blank.
#   Must be a model you have pulled (`ollama list` to see yours, `ollama pull <name>`).
OLLAMA_MODEL="gemma4:e4b"

# APP_URL
#   The URL where the app is hosted. Used for self-referential links and API
#   callbacks. AI Studio injects the Cloud Run service URL automatically.
#   For local dev this can be left blank or set to http://localhost:3000.
APP_URL=""

# PORT
#   Port the Express server listens on. Defaults to 3000.
#   If the port is already in use, the server automatically tries the next one.
# PORT=3000
